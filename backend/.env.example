# ============ PresetHub environment (copy to backend/.env for local runs; on Render use the Environment tab) ============
NODE_ENV=production
NODE_VERSION=20.11.0
CLIENT_URL=https://presethub.site
API_BASE=https://presethub.site/api

# --- Database ---
MONGODB_URI=mongodb+srv://USER:ENCODED_PASSWORD@cluster0.xxxxx.mongodb.net/presethub?retryWrites=true&w=majority
DB_LIMIT_MB=512

# --- Security ---
JWT_SECRET=<48+ random bytes as hex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
LOGIN_LOCK_AFTER=8
SIGNUP_PER_HOUR=10
UPLOAD_PER_HOUR=30
GSC_VERIFICATION_TOKEN=
GA_MEASUREMENT_ID=
META_PIXEL_ID=

# --- Admin ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ALERT_EMAIL=
ADMIN_CHAT_ID=
BACKUP_DAILY=on

# --- Payments: Cashfree (active when keys are set) ---
PAYMENT_PROVIDER=cashfree
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01
PRO_PRICE_MONTHLY=49
PRO_PRICE_QUARTERLY=129
PRO_PRICE_YEARLY=399

# --- Creator payouts ---
PAYOUT_ENC_KEY=<64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
PAYOUT_MIN_RUPEES=100
PAYOUT_AUTO_APPROVE_RUPEES=500
CREATOR_SHARE=0.8

# --- Growth & moderation ---
VIRAL_SCORE=300
AUTO_HIDE_REPORTS=5

# --- Telegram bot and channel ---
BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=PresetHub <noreply@presethub.site>

# --- Web push (node backend/scripts/generate-vapid.js) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@presethub.site

# --- Ads ---
ADSENSE_CLIENT=ca-pub-3554311294133493

# --- YOUPI PG (legacy fallback, used only if Cashfree keys are not set) ---
YOUPI_API_URL=
YOUPI_MERCHANT_ID=
YOUPI_API_KEY=
YOUPI_WEBHOOK_SECRET=
