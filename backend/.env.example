# PresetHub Backend environment template. Never commit real secrets.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:4000
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
MONGODB_URI=mongodb://127.0.0.1:27017/presethub

PAYMENT_PROVIDER=youpi

# YOUPI PG merchant integration. API URL must point to the public payment API service, not only the checkout portal.
YOUPI_API_URL=https://your-youpi-api.example.com
YOUPI_MERCHANT_ID=your-merchant-uuid
# Optional separate merchant API key; if unset, the integration uses YOUPI_WEBHOOK_SECRET as X-Merchant-Key.
YOUPI_API_KEY=
# Must match the webhook secret configured for this merchant in YOUPI PG.
YOUPI_WEBHOOK_SECRET=replace_with_the_merchant_webhook_secret



# ---- v3.2 additions ----
ADMIN_CHAT_ID=          # Telegram chat id that receives admin alerts
ADMIN_ALERT_EMAIL=      # admin e-mail for critical alerts (uses RESEND_API_KEY)
MAIL_FROM=PresetHub Alerts <alerts@presethub.site>
PRO_PRICE_MONTHLY=49
PRO_PRICE_QUARTERLY=129
PRO_PRICE_YEARLY=399
VIRAL_SCORE=300
DB_LIMIT_MB=512

# ---- Cashfree Payment Gateway (active provider when these are set) ----
# CASHFREE_ENV=sandbox for testing, production after KYC approval
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01

# ---- Creator payouts ----
# 64 hex chars (32 bytes) for encrypting creator bank/UPI details. Keep it secret and never change it after payouts exist.
PAYOUT_ENC_KEY=
# Share of preset sales and tips paid to the creator (0.8 = 80%)
CREATOR_SHARE=0.8
PAYOUT_MIN_RUPEES=100

# Payouts at or below this amount (in rupees) are approved automatically. Money is still sent by the admin.
PAYOUT_AUTO_APPROVE_RUPEES=500
