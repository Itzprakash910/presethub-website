# ============ PresetHub environment (copy to backend/.env for local runs; on Render use the Environment tab) ============
NODE_ENV=production
NODE_VERSION=20.11.0
CLIENT_URL=https://presethub.site
API_BASE=https://presethub.site/api

# --- Database ---
MONGODB_URI=mongodb+srv://USER:ENCODED_PASSWORD@cluster0.xxxxx.mongodb.net/presethub?retryWrites=true&w=majority
DB_LIMIT_MB=512

# --- Security ---
JWT_SECRET=<48+ random bytes as hex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
LOGIN_LOCK_AFTER=8
SIGNUP_PER_HOUR=10
UPLOAD_PER_HOUR=30
GSC_VERIFICATION_TOKEN=
GA_MEASUREMENT_ID=
META_PIXEL_ID=

# --- Admin ---
ADMIN_EMAIL=

ADMIN_ALERT_EMAIL=
ADMIN_CHAT_ID=
BACKUP_DAILY=on

# --- Payments: Cashfree (active when keys are set) ---
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01

# --- PhonePe Payment Gateway (Standard Checkout v2) ---
# Active gateway: leave PAYMENT_PROVIDER empty to auto-pick (Cashfree, then PhonePe, then YOUPI) or set phonepe|cashfree|youpi.
PAYMENT_PROVIDER=
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Dashboard -> Webhook -> authentication "SHA": the username/password you typed there. Webhook URL: https://<site>/api/payments/phonepe/webhook
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
PRO_PRICE_MONTHLY=49
PRO_PRICE_QUARTERLY=129
PRO_PRICE_YEARLY=399

# --- Creator payouts ---
PAYOUT_ENC_KEY=<64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
PAYOUT_MIN_RUPEES=100
PAYOUT_AUTO_APPROVE_RUPEES=500
CREATOR_SHARE=0.8

# --- Growth & moderation ---
VIRAL_SCORE=300
AUTO_HIDE_REPORTS=5

# --- Telegram bot and channel ---
BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=PresetHub <noreply@presethub.site>

# --- Web push (node backend/scripts/generate-vapid.js) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@presethub.site

# --- Ads ---
ADSENSE_CLIENT=ca-pub-3554311294133493

# --- YOUPI PG (legacy fallback, used only if Cashfree keys are not set) ---
YOUPI_API_URL=
YOUPI_MERCHANT_ID=
YOUPI_API_KEY=
YOUPI_WEBHOOK_SECRET=


# --- Server and limits (optional; defaults are used when empty) ---
PORT=
ALLOW_DEV_CORS=off
API_LIMIT_PER_15MIN=1200
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
ALERT_THROTTLE_MS=60000
BASE_PAYMENT_API_URL=

# --- Admin (password is hashed; sign-in uses the login page) ---
ADMIN_PASSWORD=
# --- Admin security and refunds ---
# Admin two-step verification is switched on per admin inside the admin panel (System -> Two-step verification). It needs PAYOUT_ENC_KEY.
REFUND_SUPER_ABOVE_RUPEES=5000

# --- Legal details shown on the Privacy, Refund and Contact pages (fill these before going live) ---
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=support@presethub.site
GRIEVANCE_OFFICER_ADDRESS=
SUPPORT_EMAIL=support@presethub.site

# --- Telegram bot admin allow-list (comma separated Telegram user IDs; ADMIN_CHAT_ID is always included) ---
ADMIN_TELEGRAM_IDS=

# --- Database backups are encrypted with this key (64 hex characters). If empty, a key derived from PAYOUT_ENC_KEY is used. ---
BACKUP_ENC_KEY=

# One-time migration: approve legacy "pending" presets on the next start, then remove this line (off by default).
# AUTO_PUBLISH_LEGACY_PENDING=on

# --- v3.25.5 ---
# HSTS: set to "off" only if some subdomain is not HTTPS-only yet (defaults: includeSubDomains + preload enabled in production).
HSTS_INCLUDE_SUBDOMAINS=on
HSTS_PRELOAD=on

# --- misc (optional) ---
# Set to "on" for ONE deploy to publish old pending presets, then remove it again.
AUTO_PUBLISH_LEGACY_PENDING=
# Set automatically by Render; only add it by hand if you serve the site from another *.onrender.com host.
RENDER_EXTERNAL_HOSTNAME=

# --- v3.25.5 hardening (all optional) ---
# Reverse proxies in front of Node: Render = 1 (default), Cloudflare in front of Render = 2. Wrong value = wrong client IP in rate limits.
TRUST_PROXY_HOPS=1
# Cloudflare Turnstile CAPTCHA on signup + password reset (leave empty to keep it off).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Only these IPs may call /api/admin (comma separated, exact addresses). Empty = no restriction.
ADMIN_IP_ALLOWLIST=
# Send a verification e-mail after signup (needs RESEND_API_KEY + MAIL_FROM). "off" disables it.
EMAIL_VERIFICATION=
# "on" = unverified e-mail addresses cannot upload presets or post texts.
REQUIRE_VERIFIED_EMAIL=
