NODE_ENV=production
PORT=4000
CLIENT_URL=https://presethub.site
JWT_SECRET=replace-with-a-long-random-32-plus-character-secret
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/presethub?retryWrites=true&w=majority
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-with-a-strong-password

# Optional Cloudflare R2 storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=presethub-files
R2_PUBLIC_URL=

# Optional Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional Telegram bot
BOT_TOKEN=
ADMIN_CHAT_ID=

# Google AdSense: publisher client only; ad slot IDs are created in AdSense
ADSENSE_CLIENT=ca-pub-3554311294133493
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_PRESET=
