PORT=4000
NODE_ENV=development

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Razorpay Dashboard > API Keys (test keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Where db.json + uploads are stored. Local: leave empty (backend/data). Railway: /data (Volume)
DATA_DIR=

# Extra allowed origins (comma separated). Same-origin needs nothing.
CORS_ORIGIN=

# Auto-creates the admin on startup if missing (password 12+ chars). Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
